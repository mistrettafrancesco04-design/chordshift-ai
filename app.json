{
  "expo": {
    "name": "CHORDSHIFT AI",
    "slug": "chordshift-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chordshift",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05060F",
    "ios": {
      "bundleIdentifier": "ai.chordshift.app",
      "supportsTablet": true,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.chordshift.app",
      "adaptiveIcon": {
        "backgroundColor": "#05060F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05060F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CHORDSHIFT AI benötigt Zugriff auf deine Fotos, um Notenblätter zu importieren.",
          "cameraPermission": "CHORDSHIFT AI benötigt die Kamera, um Notenblätter zu fotografieren.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
